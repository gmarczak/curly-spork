# Skopiuj do .env (w .gitignore). Wartości w menedżerze haseł.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa
REDIS_URL=redis://localhost:6379/1
JWT_SECRET=
COOKIE_SECRET=
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Serwis agentów (ai-agents-langgraph) — ten sam sekret co WEBHOOK_SECRET po stronie agentów
AGENTS_WEBHOOK_URL=http://localhost:8000/webhooks/medusa
AGENTS_WEBHOOK_SECRET=
# Prywatny bucket na zdjęcia klientów (P002). Puste = lokalny katalog (tylko dev): FILE_LOCAL_PRIVATE_DIR albo uploads-private/.
# `medusa develop` restartuje się po zapisie w katalogu projektu — w dev ustaw katalog poza nim, np. /tmp/medusa-uploads.
FILE_LOCAL_PRIVATE_DIR=
FILE_S3_BUCKET=
FILE_S3_URL=
FILE_S3_REGION=
FILE_S3_ENDPOINT=
FILE_S3_ACCESS_KEY_ID=
FILE_S3_SECRET_ACCESS_KEY=
