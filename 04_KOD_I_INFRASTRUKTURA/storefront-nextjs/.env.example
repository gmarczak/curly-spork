# Adres backendu Medusy. Klucze publishable są per sklep w stores.config.json (są publiczne z definicji).
MEDUSA_BACKEND_URL=http://localhost:9000
# Adres Medusy widziany z przeglądarki klienta (strona /zamow). Domyślnie = MEDUSA_BACKEND_URL.
MEDUSA_PUBLIC_URL=
# Klucz publiczny Stripe (pk_live_… / pk_test_…). Bez niego formularz zamówienia jest ukryty.
STRIPE_PUBLISHABLE_KEY=
# Tylko lokalnie: 1 = zamówienie bez płatności (pp_system_default) do testów. Nigdy w produkcji.
CHECKOUT_TEST_MODE=
